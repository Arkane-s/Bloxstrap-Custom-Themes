<BloxstrapCustomBootstrapper Version="1" Height="504" Width="896" Theme="Dark" IgnoreTitleBarInset="True" WindowCornerPreference="Round">
	
	<TitleBar 
		Title="" 
		ShowMinimize="false"
		ShowClose="True"
		Visibility="Visible"
	/>
	
<!-- Set the visibility to "Visible" to see this background (or "Hidden" to hide it) -->
