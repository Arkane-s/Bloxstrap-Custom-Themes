		Source="theme://MiniImg3.png" 
		IsAnimated="True"  
		Width="110" 
		Height="105"
		HorizontalAlignment="Right" 
		VerticalAlignment="Bottom"
		Margin="0,0,50,25"
		Visibility="Hidden"
	/>
	
	<ProgressBar 
		Height="5"
		Name="PrimaryProgressBar"
		VerticalAlignment="Bottom" 
		HorizontalAlignment="Left"
