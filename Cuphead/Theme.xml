		Source="theme://BGImg3.png"
		Stretch="UniformToFill"
		HorizontalAlignment="Center"
		Visibility="Hidden"
	/>

	<TextBlock 
			Name="Loading" 
			Text="Roblox is loading, please wait"
			HorizontalAlignment="Left"
			VerticalAlignment="Bottom"
			Margin="300,0,0,25" 
			FontFamily="Gill Sans Ultra Bold Condensed"
			FontSize="20" 
			Foreground="#FF6A00"
			Opacity="0.95"
		/>

