		Source="theme://MainBGImg.png"
		Stretch="UniformToFill" 
		HorizontalAlignment="Center"
		Visibility="Visible"
	/>
	
<!-- Set the visibility to "Visible" to see this background (or "Hidden" to hide it) -->
